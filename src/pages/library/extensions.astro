---
import Layout from "@/layouts/DocsLayout.astro";
import LibraryGrid from "@/components/LibraryGrid.astro";
import { extensionsCollection, collection } from "./_collection.ts";
const title = "Fylgja Extensions";
const description =
	"A collection of extensions, that improve the use of certain features or integrations with other Frameworks";
---

<Layout title={title} description={description} collectionName="Library" collection={collection}>
	<h1>{title}</h1>
	<p>{description}</p>
	<LibraryGrid items={extensionsCollection} />
</Layout>
