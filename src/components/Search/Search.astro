---
import { Search as SearchIcon, CornerDownLeft, ArrowDownUp } from "@lucide/astro";

interface Props {
	/** Base for the generated element ids, so several instances can coexist. */
	id?: string;
	/** Url of the JSON index the element fetches on first use. */
	index?: string;
	maxResults?: number;
	maxPerPage?: number;
	/** Set to "none" so this instance does not claim the ⌘K and / shortcuts. */
	shortcut?: "none";
	/** Names the dialog. */
	label?: string;
	/** Names the query field, kept apart from `label` so it is not announced twice. */
	inputLabel?: string;
	buttonLabel?: string;
	placeholder?: string;
	/** Shown before anything is typed. */
	idleText?: string;
	/** Shown when nothing matches, {query} is replaced with what was typed. */
	emptyText?: string;
	/** Shown when the index cannot be loaded, which is not the same as no results. */
	errorText?: string;
	resultsLabel?: string;
	navigateText?: string;
	selectText?: string;
	/** Names the keyboard hints, which are not the page footer. */
	hintsLabel?: string;
	class?: string;
	style?: string;
}

const {
	id = "site-search",
	index,
	maxResults,
	maxPerPage,
	shortcut,
	label = "Search the Fylgja site",
	inputLabel = "Search query",
	buttonLabel = "Search",
	placeholder = "Search docs, library and UI...",
	idleText = "Type to search the documentation.",
	emptyText,
	errorText,
	resultsLabel = "Search results",
	navigateText = "to navigate",
	selectText = "to select",
	hintsLabel = "Keyboard shortcuts",
	class: classes,
	style,
} = Astro.props;

const dialogId = `${id}-dialog`;
const inputId = `${id}-input`;
const resultsId = `${id}-results`;
---

<site-search
	id={id}
	index={index}
	max-results={maxResults}
	max-per-page={maxPerPage}
	shortcut={shortcut}
	empty-text={emptyText}
	error-text={errorText}
	class={classes}
	style={style}
>
	<button
		type="button"
		class="search-btn btn w-full"
		data-search-open
		aria-label={buttonLabel}
	>
		<SearchIcon class="search-btn-icon flex-none" width={22} height={22} aria-hidden="true" />
		<span class="search-btn-label">{buttonLabel}</span>
		<kbd class="search-btn-keys" data-search-keys aria-hidden="true"></kbd>
	</button>

	<dialog id={dialogId} class="search-dialog" closedby="any" aria-label={label}>
		<search>
			<form class="search-form" autocomplete="off">
				<label class="sr-only" for={inputId}>{inputLabel}</label>
				<div class="search-field input-group">
					<SearchIcon class="flex-none" width={18} height={18} aria-hidden="true" />
					<input
						id={inputId}
						class="search-input"
						data-search-input
						type="search"
						name="q"
						placeholder={placeholder}
						autocomplete="off"
						autocorrect="off"
						autocapitalize="off"
						spellcheck="false"
						role="combobox"
						aria-expanded="false"
						aria-controls={resultsId}
						aria-autocomplete="list"
					/>
					<button
						type="button"
						class="search-close btn text-sm"
						data-search-close
					>
						<kbd>Esc</kbd>
					</button>
				</div>
			</form>

			<div class="search-panel scroll-y">
				<div
					id={resultsId}
					class="search-results"
					data-search-results
					role="listbox"
					aria-label={resultsLabel}
				></div>
				<p class="search-status text-muted text-sm" data-search-status role="status">
					{idleText}
				</p>
			</div>
		</search>

		<footer
			class="search-footer flex-wrap align gap text-muted text-sm"
			role="group"
			aria-label={hintsLabel}
		>
			<span class="flex align gap-sm">
				<ArrowDownUp class="flex-none" width={14} height={14} aria-hidden="true" />
				{navigateText}
			</span>
			<span class="flex align gap-sm">
				<CornerDownLeft class="flex-none" width={14} height={14} aria-hidden="true" />
				{selectText}
			</span>
		</footer>
	</dialog>
</site-search>

<script>
	import "./site-search.js";
</script>

<style is:global>
	.search-btn {
		--btn-stroke: color-mix(in srgb, var(--root-fg), transparent 80%);
		--btn-bg: var(--root-bg);
		--btn-px: 0.875em;
		border-width: 1px;
		justify-content: flex-start;
		opacity: 0.7;

		&:is(:hover, :focus-visible) {
			opacity: 1;
		}
	}

	.search-btn-keys {
		display: none;
		margin-inline-start: auto;
		padding-inline-start: 1.5rem;
		font-family: inherit;
		font-size: 0.875rem;
	}

	@media (width < 768px) {
		.search-btn {
			--btn-px: 0.5rem;
			--btn-stroke: transparent;
			--btn-bg: transparent;
		}

		.search-btn-label {
			display: none;
		}
	}

	@media (width >= 768px) {
		.search-btn-keys:not(:empty) {
			display: block;
		}

		.search-btn-icon {
			width: 1em;
			height: 1em;
		}
	}

	.search-dialog {
		--my: max(4vh, 1rem) auto;
		--dialog-translate-y: -1rem;
		inline-size: min(100%, 40rem);
		max-block-size: min(32rem, calc(100% - 2rem));
		padding: 0;

		&[open] {
			display: grid;
			grid-template-rows: minmax(0, 1fr) auto;
		}

		/* The quick search results belong inside <search>, so it carries the rows
		   the dialog used to: the field, then the scrolling panel. */
		& > search {
			display: grid;
			grid-template-rows: auto minmax(0, 1fr);
			min-block-size: 0;
		}
	}

	.search-field {
		--form-stroke: transparent;
		--form-bg: transparent;
		--form-radius: 0;
		--rounded: 0; /* NOTE: Remove after updating the input-group */
		--outline-offset: -2px;
		padding-inline: 1rem;
		border-block-end: 1px solid var(--border-color-fade, #0002);

		& input {
			--form-py: 1rem;
        	--form-border-width: 0;
		}
	}

	.search-close {
		--btn-stroke: transparent;
		--btn-px: 0.25rem;
		--btn-py: 0.25rem;

		& kbd {
			font-family: inherit;
			font-size: 0.75rem;
			padding: 0.125rem 0.375rem;
			border: 1px solid var(--border-color-fade, #0002);
			border-radius: 0.25rem;
		}
	}

	.search-panel {
		padding: 0.5rem;
	}

	.search-status:empty {
		display: none;
	}

	.search-status {
		margin: 0;
		padding: 1.5rem 0.5rem;
		text-align: center;
	}

	.search-hit {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0 0.75rem;
		align-items: baseline;
		padding: 0.625rem 0.75rem;
		border-radius: 0.5rem;
		color: inherit;
		text-decoration: none;
		scroll-margin: 0.5rem;

		&:is(:hover, [aria-selected="true"]) {
			background-color: var(--brand-fade, color-mix(in srgb, currentcolor, transparent 90%));
		}

		& mark {
			background-color: transparent;
			color: color-mix(in srgb, var(--link-color, var(--brand)) 80%, var(--root-fg));
			font-weight: 600;
			padding: 0;
		}
	}

	.search-hit-title {
		font-weight: 500;
	}

	.search-hit-heading::before {
		content: "›";
		margin-inline: 0.375rem;
		color: var(--text-color-muted);
	}

	.search-hit-text {
		grid-column: 1;
		margin-block-start: 0.125rem;
		color: var(--text-color-muted);
		font-size: 0.875rem;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.search-hit-source {
		grid-row: 1;
		grid-column: 2;
	}

	.search-footer {
		--align: center;
		gap: 1rem;
		padding: 0.625rem 1rem;
		border-block-start: 1px solid var(--border-color-fade, #0002);
	}

	@media (width < 640px) {
		.search-footer {
			display: none;
		}
	}
</style>
